// example.yu

export function main(): i32 {
    let msg: string = "Hello from YuLang with Closures and Arrays!";
    clib.printf("%s\n", msg.ptr);
    
    // 1. Array with Dynamic Push
    let arr: array<i32> = [10, 20];
    clib.printf("Initial length: %d\n", arr.length);
    
    arr.push(30);
    arr.push(40);
    clib.printf("Final length: %d\n", arr.length);
    
    // 2. Access elements
    clib.printf("arr[0] = %d\n", arr[0]);
    clib.printf("arr[2] = %d\n", arr[2]);
    clib.printf("arr[3] = %d\n", arr[3]);
    
    return 0;
}
