import { writeFileSync, appendFileSync, readFileSync, existsSync } from "std:fs";
import { println } from "std:io";

export function main(): i32 {
    let path: string = "/tmp/yu_fs_read_write.txt";
    writeFileSync(path, "hello");
    appendFileSync(path, "\nworld");

    let content: string = readFileSync(path);
    println("file content:");
    println(content);

    let exists: bool = existsSync(path);
    println("exists:");
    println(exists as string);
    return 0;
}
