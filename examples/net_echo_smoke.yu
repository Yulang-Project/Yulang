import * as net from "std:net";

export function main(): i32 {
    let server = net.createServer((socket: net.Socket): void => {
        socket.on("data", (data: string): void => {
            clib.printf("server received: %s\n", data.ptr);
            socket.write("pong", (err: i32): void => {
            });
        });
    });

    server.listen(8124, "127.0.0.1", (): void => {
        clib.printf("server listening\n");
    });

    let client = net.connect(8124, "127.0.0.1", (socket: net.Socket): void => {
        socket.write("ping", (err: i32): void => {
        });
    });

    client.on("data", (data: string): void => {
        clib.printf("client received: %s\n", data.ptr);
        client.destroy();
        server.close();
    });

    return 0;
}
