import * as uv from "std:uv";

export function writeFile(path: string, content: string): i32 {
    return uv.uv_writefile(path, content);
}

export function appendFile(path: string, content: string): i32 {
    return uv.uv_appendfile(path, content);
}

export function readFileSync(path: string): string {
    return uv.uv_read_text(path);
}

export function readFile(path: string, callback: (err: i32, data: string) => void): void {
    uv.uv_readFile(path, callback);
}

export function unlink(path: string): i32 {
    return uv.uv_unlink(path);
}

export function rename(oldPath: string, newPath: string): i32 {
    return uv.uv_rename(oldPath, newPath);
}

export function mkdir(path: string, mode: i32): i32 {
    return uv.uv_mkdir(path, mode);
}

export function rmdir(path: string): i32 {
    return uv.uv_rmdir(path);
}

export function access(path: string, mode: i32): i32 {
    return uv.uv_access(path, mode);
}

export function exists(path: string): i32 {
    return uv.uv_access(path, 0);
}

// Legacy aliases.
export function write_text(path: string, content: string): i32 { return uv.uv_writefile(path, content); }
export function append_text(path: string, content: string): i32 { return uv.uv_appendfile(path, content); }
export function read_text(path: string): string { return uv.uv_read_text(path); }
export function remove_file(path: string): i32 { return uv.uv_unlink(path); }
export function rename_file(oldPath: string, newPath: string): i32 { return uv.uv_rename(oldPath, newPath); }
export function make_dir(path: string, mode: i32): i32 { return uv.uv_mkdir(path, mode); }
export function remove_dir(path: string): i32 { return uv.uv_rmdir(path); }
export function file_exists(path: string): i32 { return uv.uv_access(path, 0); }
