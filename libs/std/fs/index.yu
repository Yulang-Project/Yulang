export function write_text(path: string, content: string): i32 {
    return clib.writefile(path, content);
}

export function append_text(path: string, content: string): i32 {
    return clib.appendfile(path, content);
}

export function read_text(path: string): string {
    return clib.readfile(path);
}

export function remove_file(path: string): i32 {
    return clib.unlink(path);
}

export function rename_file(oldPath: string, newPath: string): i32 {
    return clib.rename(oldPath, newPath);
}

export function make_dir(path: string, mode: i32): i32 {
    return clib.mkdir(path, mode);
}

export function remove_dir(path: string): i32 {
    return clib.rmdir(path);
}

export function file_exists(path: string): i32 {
    return clib.access(path, 0);
}
