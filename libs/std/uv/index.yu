export function uv_read_text(path: string): string {
    return clib.readfile(path);
}

export function uv_readFile(path: string, callback: (err: i32, data: string) => void): void {
    clib.readFile(path, callback);
}

export function uv_readFilePromise(path: string): Promise<string> {
    return clib.readFilePromise(path);
}

export function uv_writefile(path: string, content: string): i32 {
    return clib.writefile(path, content);
}

export function uv_appendfile(path: string, content: string): i32 {
    return clib.appendfile(path, content);
}

export function uv_unlink(path: string): i32 {
    return clib.unlink(path);
}

export function uv_rename(oldPath: string, newPath: string): i32 {
    return clib.rename(oldPath, newPath);
}

export function uv_mkdir(path: string, mode: i32): i32 {
    return clib.mkdir(path, mode);
}

export function uv_rmdir(path: string): i32 {
    return clib.rmdir(path);
}

export function uv_access(path: string, mode: i32): i32 {
    return clib.access(path, mode);
}
